@startuml
left to right direction
actor "User" as User
actor "Admin" as Admin

rectangle "VIT Management System" {
  usecase "Log In" as UC1
  usecase "View Application Forms" as UC2
  usecase "View Interviews" as UC3
  usecase "View Mentor Meetings" as UC4
  usecase "Set Preferences (User)" as UC5
  usecase "Monitor Events" as UC6
  usecase "Send Emails to Addresses" as UC7
  usecase "Set Preferences (Admin)" as UC8
}

User -- UC1
User -- UC2
User -- UC3
User -- UC4
User -- UC5

Admin -- UC1
Admin -- UC6
Admin -- UC7
Admin -- UC8

' Optional: Include relationships for more detail
 UC1 ..> (Validate User Login) : <<include>>
 UC1 ..> (Validate Admin Login) : <<include>>

' These relationships indicate that a use case 'uses' another module or system.
' You can uncomment them if you want to show these dependencies.
 UC2 ..> (Find Excel Files) : <<uses>>
 UC3 ..> (Find Excel Files) : <<uses>>
 UC4 ..> (Find Excel Files) : <<uses>>
 UC6 ..> (Retrieve Calendar Events) : <<uses>>
 UC7 ..> (Auth Module) : <<uses>> ' For authentication to send emails
 (Validate User Login) <. (Auth Module) : <<uses>>
 (Validate Admin Login) <. (Auth Module) : <<uses>>

@enduml